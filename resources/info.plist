<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Murmr Flow</string>

	<key>CFBundleDisplayName</key>
	<string>Murmr Flow</string>

	<key>CFBundleExecutable</key>
	<string>MurmrFlow</string>

	<!-- PERMANENT. TCC keys permission grants off this. Changing it silently resets
	     every permission for every user. -->
	<key>CFBundleIdentifier</key>
	<string>app.murmr.MurmrFlow</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>

	<key>CFBundleVersion</key>
	<string>__BUILD__</string>

	<!-- Bundled fonts, registered for this process only. Nothing is installed into
	     the user's font library, and nothing is assumed to be there already. -->
	<key>ATSApplicationFontsPath</key>
	<string>Fonts</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.2</string>

	<!-- Menu-bar only: no Dock icon, no main window. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Shown verbatim in the system microphone prompt. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Murmr Flow needs the microphone to turn your speech into text. Audio is transcribed on this Mac and never uploaded.</string>

	<!-- Meetings mode (v2) will also need system audio capture via Core Audio process
	     taps. Declared early so the string is reviewed alongside the mic one. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Murmr Flow needs system audio to record the other participants in a meeting. Audio is transcribed on this Mac and never uploaded.</string>

	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
