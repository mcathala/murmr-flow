# Build output
.build/
build/
*.app

# Signing — never commit certificates or keys
*.p12
*.pem
*.key
*.cer
*.certSigningRequest

# Local overrides
.env
.env.local
scripts/local-*.sh

# Agent scratch space and git worktrees
.claude/

# Design docs are kept locally for now — but the README's screenshots are not a design
# doc, they are part of what the repo publishes. `docs/*` rather than `docs/`, because
# git will not look inside an excluded directory to find the exception.
docs/*
!docs/screenshots/

# Models are downloaded at runtime, never committed (~600 MB each)
Models/

# macOS
.DS_Store
._*

# Xcode / SwiftPM
*.xcuserstate
*.xcworkspace/xcuserdata/
.swiftpm/

# Package.resolved IS tracked: this is an application, not a library, so pinning
# exact dependency versions is what makes builds reproducible.
